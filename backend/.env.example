# Gere um segredo longo e aleat\u00f3rio, por exemplo:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
LK_CLIP_JWT_SECRET=replace-with-at-least-32-random-bytes

# Conexao PostgreSQL usada pelo backend.
LK_CLIP_DATABASE_URL=postgresql://usuario:senha@localhost:5432/lk_clip

# Emails autorizados a usar GET /users/me/listar, separados por vírgula.
# LK_CLIP_ADMIN_EMAILS=admin@example.com

# Opcional: origens web separadas por v\u00edrgula.
# LK_CLIP_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
# Opcional: origem Cloudflare; use {category} para montar a URL por categoria.
LK_CLIP_CLOUDFLARE_CATALOG_URL=https://seu-dominio.workers.dev/catalog/{category}
# Opcional: manifesto com a lista de categorias disponíveis — é o que
# permite o app descobrir sozinho quais fileiras mostrar, sem precisar
# tocar no código nem publicar uma versão nova dele. Formato:
#   [{"key": "filmes-exclusivos", "label": "Exclusivos", "icon": "⚡"}, ...]
LK_CLIP_CLOUDFLARE_CATEGORIES_URL=https://seu-dominio.workers.dev/categories.json
